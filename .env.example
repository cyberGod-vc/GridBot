# Capital.com DEMO credentials only
CAPITAL_API_KEY=replace_with_demo_api_key
CAPITAL_IDENTIFIER=you@example.com
CAPITAL_PASSWORD=replace_with_demo_api_password
CAPITAL_BASE_URL=https://demo-api-capital.backend-capital.com/

# Automatic discovery: searches Capital.com's Demo API for this display name.
# The bot reads the epic from the API response; it does not guess an epic.
INSTRUMENT_SEARCH_TERM=Gold
INSTRUMENT_NAME=Gold Spot
# Optional: leave blank to auto-discover. Only set after independently verifying.
INSTRUMENT_EPIC=

# Optional Telegram alerts
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=

# Optional operational settings
SQLITE_PATH=bot_state.sqlite3
LOG_LEVEL=INFO
